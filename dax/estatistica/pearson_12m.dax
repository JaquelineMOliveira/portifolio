Pearson 12M = 
VAR DataFinal =
    MAX(dCalendario[Data])

VAR Meses12M =
    ADDCOLUMNS(
        GENERATESERIES(0, 11, 1),
        "@InicioMes",
            EOMONTH(
                DataFinal,
                -[Value] - 1
            ) + 1,
        "@FimMes",
            EOMONTH(
                DataFinal,
                -[Value]
            )
    )

VAR Base12M =
    ADDCOLUMNS(
        Meses12M,
        "@Preco",
            VAR InicioMes = [@InicioMes]
            VAR FimMes = [@FimMes]
            RETURN
                CALCULATE(
                    [PMV],
                    REMOVEFILTERS(dCalendario[Data]),
                    DATESBETWEEN(
                        dCalendario[Data],
                        InicioMes,
                        FimMes
                    )
                ),
        "@Volume",
            VAR InicioMes = [@InicioMes]
            VAR FimMes = [@FimMes]
            RETURN
                CALCULATE(
                    [Volume Total],
                    REMOVEFILTERS(dCalendario[Data]),
                    DATESBETWEEN(
                        dCalendario[Data],
                        InicioMes,
                        FimMes
                    )
                )
    )

VAR BaseValida =
    FILTER(
        Base12M,
        NOT ISBLANK([@Preco])
            && NOT ISBLANK([@Volume])
            && [@Preco] > 0
            && [@Volume] > 0
    )

VAR MediaPreco =
    AVERAGEX(
        BaseValida,
        [@Preco]
    )

VAR MediaVolume =
    AVERAGEX(
        BaseValida,
        [@Volume]
    )

VAR Numerador =
    SUMX(
        BaseValida,
        ([@Preco] - MediaPreco)
            *
        ([@Volume] - MediaVolume)
    )

VAR SomaQuadradosPreco =
    SUMX(
        BaseValida,
        ([@Preco] - MediaPreco) ^ 2
    )

VAR SomaQuadradosVolume =
    SUMX(
        BaseValida,
        ([@Volume] - MediaVolume) ^ 2
    )

VAR Denominador =
    SQRT(
        SomaQuadradosPreco
            *
        SomaQuadradosVolume
    )

RETURN
IF(
    COUNTROWS(BaseValida) < 3
        || Denominador = 0,
    BLANK(),
    DIVIDE(
        Numerador,
        Denominador
    )
)
